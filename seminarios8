<!DOCTYPE html>
<html lang="pt-BR">
<head>
<meta charset="utf-8">
<meta name="viewport" content="width=device-width, initial-scale=1">
<title>Seminários VIII, cronograma de tarefas</title>
<meta name="description" content="Cronograma das tarefas de Seminários VIII por grupo de trabalho, de agosto a dezembro de 2026.">
<link rel="preconnect" href="https://fonts.googleapis.com">
<link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
<link href="https://fonts.googleapis.com/css2?family=Bricolage+Grotesque:opsz,wght@12..96,400;12..96,600;12..96,800&family=Instrument+Sans:wght@400;500;600&family=IBM+Plex+Mono:wght@400;500&display=swap" rel="stylesheet">
<style>
:root{
  --ink:#16232b;
  --paper:#eff1ec;
  --card:#f8f9f6;
  --rule:#d4d9d0;
  --muted:#5f6f74;
  --faint:#8b9a9c;
  --on-c:#ffffff;
  --g-escola:#1057c9;
  --g-palestrantes:#00798f;
  --g-ebook:#0b7a38;
  --g-comida:#a66f00;
  --g-espaco:#cc4400;
  --g-materiais:#a80c2e;
  --g-divulgacao:#6a1fd0;
  --g-institucionais:#be1490;
}
@media (prefers-color-scheme: dark){
  :root{
    --ink:#e8ece6;
    --paper:#11171a;
    --card:#1a2226;
    --rule:#2c383d;
    --muted:#9aabaf;
    --faint:#6d7f84;
    --on-c:#0d1214;
    --g-escola:#6c9dff;
    --g-palestrantes:#2fc6dc;
    --g-ebook:#3ecc72;
    --g-comida:#e8b62c;
    --g-espaco:#ff8340;
    --g-materiais:#ff667f;
    --g-divulgacao:#b184ff;
    --g-institucionais:#ff6ed0;
  }
}
*{box-sizing:border-box}
html{-webkit-text-size-adjust:100%}
body{
  margin:0;
  background:var(--paper);
  color:var(--ink);
  font-family:"Instrument Sans",system-ui,sans-serif;
  font-size:16px;
  line-height:1.55;
  -webkit-font-smoothing:antialiased;
}
.wrap{max-width:920px;margin:0 auto;padding:40px 24px 80px}

/* cabeçalho */
.eyebrow{
  font-family:"IBM Plex Mono",monospace;
  font-size:12px;letter-spacing:.14em;text-transform:uppercase;
  color:var(--faint);margin:0 0 14px;
}
h1{
  font-family:"Bricolage Grotesque",sans-serif;
  font-weight:800;font-size:clamp(34px,7vw,58px);
  line-height:.98;letter-spacing:-.025em;margin:0 0 18px;
}
.lede{max-width:52ch;color:var(--muted);margin:0 0 28px;font-size:17px}
.aviso{
  display:flex;gap:12px;align-items:flex-start;
  border:1px dashed var(--rule);border-radius:2px;
  padding:14px 16px;margin:0 0 36px;font-size:14px;color:var(--muted);
}
.aviso b{color:var(--ink);font-weight:600}

/* seletor de grupos, os crachás */
.selector{margin:0 0 8px}
.selector h2{
  font-family:"IBM Plex Mono",monospace;font-weight:500;
  font-size:12px;letter-spacing:.14em;text-transform:uppercase;
  color:var(--faint);margin:0 0 14px;
}
.tags{display:flex;flex-wrap:wrap;gap:8px}
.tag{
  font:500 14px/1 "Instrument Sans",sans-serif;
  border:1px solid var(--rule);background:transparent;color:var(--ink);
  border-radius:2px;padding:9px 13px 9px 11px;cursor:pointer;
  display:inline-flex;align-items:center;gap:8px;
  transition:border-color .15s,background .15s;
}
.tag:hover{border-color:var(--ink)}
.tag:focus-visible{outline:2px solid var(--ink);outline-offset:2px}
.tag .dot{width:10px;height:10px;border-radius:50%;background:var(--c,currentColor);flex:0 0 auto}
.tag[aria-pressed="true"]{background:var(--c,var(--ink));color:var(--on-c);border-color:var(--c,var(--ink))}
.tag[aria-pressed="true"] .dot{background:var(--on-c)}
.tag[data-g="todos"] .dot{display:none}
.tag[data-g="escola"]{--c:var(--g-escola);color:var(--c)}
.tag[data-g="palestrantes"]{--c:var(--g-palestrantes);color:var(--c)}
.tag[data-g="ebook"]{--c:var(--g-ebook);color:var(--c)}
.tag[data-g="comida"]{--c:var(--g-comida);color:var(--c)}
.tag[data-g="espaco"]{--c:var(--g-espaco);color:var(--c)}
.tag[data-g="materiais"]{--c:var(--g-materiais);color:var(--c)}
.tag[data-g="divulgacao"]{--c:var(--g-divulgacao);color:var(--c)}
.tag[data-g="institucionais"]{--c:var(--g-institucionais);color:var(--c)}

/* barra de progresso */
.progresso{
  display:flex;align-items:center;gap:14px;
  margin:26px 0 40px;padding-top:22px;border-top:1px solid var(--rule);
}
.barra{flex:1;height:3px;background:var(--rule);position:relative;overflow:hidden}
.barra span{position:absolute;inset:0 auto 0 0;width:0;background:var(--ink);transition:width .35s ease}
.contador{font-family:"IBM Plex Mono",monospace;font-size:13px;color:var(--muted);white-space:nowrap}
.reset{
  font:400 13px/1 "Instrument Sans",sans-serif;background:none;border:0;
  color:var(--faint);cursor:pointer;text-decoration:underline;text-underline-offset:3px;padding:4px;
}
.reset:hover{color:var(--ink)}

/* linha do tempo */
.encontro{
  display:grid;grid-template-columns:112px 1fr;gap:28px;
  padding:26px 0;border-top:1px solid var(--rule);
}
.encontro:last-of-type{border-bottom:1px solid var(--rule)}
.encontro.apagado{opacity:.34}
.encontro.evento .data{color:var(--ink)}
.encontro.evento .pauta{border-left:2px solid var(--ink);padding-left:14px}
.data{font-family:"IBM Plex Mono",monospace;line-height:1.35}
.data .ter{font-size:22px;font-weight:500;display:block;letter-spacing:-.02em}
.data .qui{font-size:13px;color:var(--faint);display:block;margin-top:2px}
.data .n{
  display:inline-block;margin-top:10px;font-size:11px;letter-spacing:.08em;
  text-transform:uppercase;color:var(--faint);
}
.pauta{margin:0 0 16px;font-size:15px;color:var(--muted);max-width:56ch}
.pauta strong{color:var(--ink);font-weight:600}
.semaula{font-style:italic}

/* tarefas */
.lista{list-style:none;margin:0;padding:0;display:grid;gap:6px}
.lista.duas{grid-template-columns:repeat(auto-fill,minmax(232px,1fr))}
.item{
  display:flex;gap:11px;align-items:flex-start;
  background:var(--card);border:1px solid var(--rule);border-radius:2px;
  padding:11px 13px;position:relative;
  transition:border-color .15s;
}
.item:hover{border-color:var(--faint)}
.item::before{content:"";position:absolute;inset:0 auto 0 0;width:4px;background:var(--c,var(--ink))}
.item{color:var(--ink)}
.item[data-g]{background:color-mix(in srgb, var(--c) 8%, var(--card));border-color:color-mix(in srgb, var(--c) 26%, var(--rule))}
.item[data-g="escola"]{--c:var(--g-escola)}
.item[data-g="palestrantes"]{--c:var(--g-palestrantes)}
.item[data-g="ebook"]{--c:var(--g-ebook)}
.item[data-g="comida"]{--c:var(--g-comida)}
.item[data-g="espaco"]{--c:var(--g-espaco)}
.item[data-g="materiais"]{--c:var(--g-materiais)}
.item[data-g="divulgacao"]{--c:var(--g-divulgacao)}
.item[data-g="institucionais"]{--c:var(--g-institucionais)}
.item label{display:flex;gap:11px;align-items:flex-start;cursor:pointer;width:100%}
.item input{
  appearance:none;-webkit-appearance:none;margin:2px 0 0;flex:0 0 auto;
  width:17px;height:17px;border:1px solid var(--faint);border-radius:2px;
  background:transparent;cursor:pointer;position:relative;
}
.item input:checked{background:currentColor;border-color:currentColor}
.item input:checked::after{
  content:"";position:absolute;left:5px;top:2px;width:5px;height:9px;
  border:solid var(--card);border-width:0 2px 2px 0;transform:rotate(42deg);
}
.item input:focus-visible{outline:2px solid var(--ink);outline-offset:2px}
.txt{min-width:0}
.grupo{
  font-family:"IBM Plex Mono",monospace;font-size:11px;letter-spacing:.06em;
  text-transform:uppercase;display:block;margin-bottom:2px;
}
.acao{font-size:14.5px;color:var(--ink);line-height:1.4;display:block}
.item input:checked ~ .txt .acao{text-decoration:line-through;color:var(--faint)}
.vazio{font-size:14px;color:var(--faint);font-style:italic}

footer{
  margin-top:56px;padding-top:22px;border-top:1px solid var(--rule);
  font-size:13px;color:var(--faint);
}
@media (max-width:640px){
  .wrap{padding:28px 18px 60px}
  .encontro{grid-template-columns:1fr;gap:14px;padding:22px 0}
  .data{display:flex;align-items:baseline;gap:10px}
  .data .ter{font-size:19px}
  .data .n{margin-top:0;margin-left:auto}
  .lista.duas{grid-template-columns:1fr}
}
@media (prefers-reduced-motion:reduce){*{transition:none!important;animation:none!important}}
@media print{
  body{background:#fff;color:#000}
  .selector,.progresso,.aviso,.reset{display:none}
  .encontro{break-inside:avoid}
  .item{background:#fff}
}
</style>
</head>
<body>
<div class="wrap">
<header>
  <p class="eyebrow">Seminários VIII</p>
  <h1>Cronograma<br>de tarefas</h1>
  <p class="lede">Cada data é o prazo limite, não o dia de começar. O trabalho acontece no intervalo entre um encontro e o seguinte, e a aula que cai na data serve para conferir o que venceu e distribuir o ciclo seguinte.</p>
  <div class="aviso">
    <span aria-hidden="true">◇</span>
    <span><b>A data do evento ainda depende da escola.</b> É 12/11 ou 26/11, sempre numa quinta. As nove tarefas do dia do evento aparecem no bloco marcado, e mudam de lugar quando a escola responder.</span>
  </div>
</header>

<section class="selector" aria-labelledby="sel-h">
  <h2 id="sel-h">Filtre pelo seu grupo</h2>
  <div class="tags" id="tags" role="group" aria-label="Grupos de trabalho"></div>
</section>

<div class="progresso">
  <div class="barra" role="progressbar" aria-label="Tarefas concluídas" aria-valuemin="0" aria-valuemax="100" aria-valuenow="0" id="barra"><span id="barra-fill"></span></div>
  <span class="contador" id="contador">0 de 38 concluídas</span>
  <button class="reset" id="reset" type="button">Limpar marcações</button>
</div>

<main id="timeline"></main>

<footer>
  <p>As marcações ficam salvas neste navegador. Cada pessoa vê as suas.</p>
</footer>
</div>

<script>
/* Grupos de trabalho. A chave é usada nas tarefas abaixo. */
const GRUPOS = {
  escola:        "Escola",
  palestrantes:  "Palestrantes",
  ebook:         "E-book",
  comida:        "Logística comida",
  espaco:        "Logística espaço",
  materiais:     "Logística materiais",
  divulgacao:    "Mídias divulgação",
  institucionais:"Mídias institucionais"
};

/* Encontros em ordem cronológica. Para editar o cronograma, mexa só aqui. */
const ENCONTROS = [
  { ter:"04/08", qui:"06/08",
    pauta:"Alinhamentos iniciais e análise do questionário. Fechar a proposta para a escola com as duas datas candidatas.",
    tarefas:[] },

  { ter:"18/08", qui:"20/08",
    pauta:"Divisão da turma nos oito grupos, distribuição de tarefas, mapeamento de convidados e da identidade visual. Cada grupo sai com os itens de 01/09 e 15/09 na mão.",
    tarefas:[] },

  { ter:"01/09", qui:"03/09",
    pauta:"Relato de trabalho e alinhamento. Conferência dos dois primeiros contatos.",
    tarefas:[
      { g:"escola",       t:"Primeiro contato com a escola, resposta à proposta e número de alunos" },
      { g:"palestrantes", t:"Primeiro contato com os palestrantes, resposta à proposta e número de convidados" },
      { g:"divulgacao",   t:"Conferir se há verba para o banner da extensão" }
    ] },

  { ter:"15/09", qui:"17/09",
    pauta:"Primeira versão do e-book e comentários da turma, mais relato de trabalho.",
    tarefas:[
      { g:"escola",       t:"Acompanhamento da escola" },
      { g:"palestrantes", t:"Acompanhamento e checagem de demandas por materiais" },
      { g:"ebook",        t:"Entrega da primeira versão" },
      { g:"comida",       t:"Orçamento e definição do fornecedor, com materiais do lanche" },
      { g:"espaco",       t:"Definir a reserva do espaço com o CSC" },
      { g:"divulgacao",   t:"Primeira versão dos materiais de divulgação" }
    ] },

  { ter:"29/09", qui:"01/10",
    pauta:"Segunda versão do e-book, alinhamento pré-recesso e relato de trabalho. Distribuir as dez tarefas de 27/10, com metade marcada para estar pronta em 13/10.",
    tarefas:[
      { g:"escola",       t:"Acompanhamento da escola" },
      { g:"palestrantes", t:"Acompanhamento e checagem de demandas por materiais" },
      { g:"ebook",        t:"Entrega da segunda versão" },
      { g:"comida",       t:"Alinhamento com o Centro de Produção do ICS" },
      { g:"espaco",       t:"Contato com o CSC para o layout do espaço" },
      { g:"materiais",    t:"Conferir disponibilidade dos materiais pedidos pelos palestrantes" },
      { g:"divulgacao",   t:"Versão final dos materiais de divulgação" }
    ] },

  { ter:"13/10", qui:"15/10", semaula:true,
    pauta:"MINIONU, não haverá aula. Cada grupo envia relato por escrito no registro compartilhado, com metade dos itens de 27/10 já prontos.",
    tarefas:[] },

  { ter:"27/10", qui:"29/10",
    pauta:"Entrega final do e-book e ensaio da operação do dia. Sai daqui a escala nominal por horário, o mapa do espaço, a pauta do mestre de cerimônia e o plano B para ausência de palestrante.",
    tarefas:[
      { g:"escola",         t:"Confirmação final da escola" },
      { g:"palestrantes",   t:"Confirmação final dos palestrantes" },
      { g:"ebook",          t:"Entrega da versão final" },
      { g:"comida",         t:"Aprovação da verba do Centro de Produção e contato com o fornecedor" },
      { g:"espaco",         t:"Mapa final do espaço e verificação do layout" },
      { g:"materiais",      t:"Conferir disponibilidade final dos materiais com o CSC" },
      { g:"divulgacao",     t:"Começar a divulgação e confeccionar o convite" },
      { g:"institucionais", t:"Crachás da equipe e dos palestrantes" },
      { g:"institucionais", t:"Plaquinhas dos estandes" },
      { g:"institucionais", t:"Material do mestre de cerimônia, pauta e mini-currículos" }
    ] },

  { ter:"10/11", qui:"12/11",
    pauta:"Se o evento for em 12/11, esta terça é a última preparação e a quinta é o próprio evento. A autorização de entrada de material vence hoje, dois dias antes.",
    tarefas:[
      { g:"materiais", t:"Lista de autorização de entrada de material, se houver" }
    ] },

  { evento:true, ter:"Dia do evento", qui:"12/11 ou 26/11",
    pauta:"O bloco inteiro anda junto com a data que a escola confirmar. A formatação da divulgação do e-book vence na véspera.",
    tarefas:[
      { g:"ebook",        t:"Formatação da divulgação do e-book, na véspera" },
      { g:"escola",       t:"Recepção da escola" },
      { g:"palestrantes", t:"Recepção dos palestrantes" },
      { g:"comida",       t:"Buscar e organizar o lanche" },
      { g:"espaco",       t:"Organização do espaço, junto com materiais" },
      { g:"materiais",    t:"Lista de presença dos alunos" },
      { g:"materiais",    t:"Organização do espaço, junto com espaço" },
      { g:"divulgacao",   t:"Registro fotográfico" },
      { g:"divulgacao",   t:"Registro em redes sociais" }
    ] },

  { ter:"24/11", qui:"26/11",
    pauta:"Debrief, se o evento tiver acontecido em 12/11, com a divisão da redação do relatório. Se for em 26/11, esta terça é a última preparação e a quinta é o próprio evento.",
    tarefas:[] },

  { ter:"08/12", qui:"10/12",
    pauta:"Fechamento operacional, com envio dos certificados e divulgação do e-book.",
    tarefas:[
      { g:"institucionais", t:"Certificados, layout e preenchimento final" },
      { g:"materiais",      t:"Devolução dos materiais" }
    ] },

  { ter:"15/12", qui:"17/12",
    pauta:"Alinhamentos finais, relatório e avaliação da disciplina.",
    tarefas:[] }
];

const CHAVE = "seminarios8";
let feitas = new Set();
let filtro = "todos";

try {
  const salvo = localStorage.getItem(CHAVE);
  if (salvo) feitas = new Set(JSON.parse(salvo));
} catch (e) {}

function salvar(){
  try { localStorage.setItem(CHAVE, JSON.stringify([...feitas])); } catch (e) {}
}

function montarTags(){
  const alvo = document.getElementById("tags");
  const lista = [["todos","Todos os grupos"], ...Object.entries(GRUPOS)];
  alvo.innerHTML = lista.map(([k,nome]) =>
    `<button class="tag" type="button" data-g="${k}" aria-pressed="${k===filtro}">
       <span class="dot" aria-hidden="true"></span>${nome}</button>`).join("");
  alvo.querySelectorAll(".tag").forEach(b => b.addEventListener("click", () => {
    filtro = b.dataset.g === filtro ? "todos" : b.dataset.g;
    montarTags(); montarTimeline(); atualizarProgresso();
  }));
}

function montarTimeline(){
  const alvo = document.getElementById("timeline");
  alvo.innerHTML = ENCONTROS.map((e, i) => {
    const visiveis = filtro === "todos" ? e.tarefas : e.tarefas.filter(t => t.g === filtro);
    const apagado = filtro !== "todos" && visiveis.length === 0;
    const n = e.tarefas.length;
    const rotulo = filtro === "todos"
      ? (n ? `${n} ${n === 1 ? "tarefa" : "tarefas"}` : "")
      : (visiveis.length ? `${visiveis.length} ${visiveis.length === 1 ? "sua" : "suas"}` : "");
    const itens = visiveis.map((t, j) => {
      const id = `t-${i}-${e.tarefas.indexOf(t)}-${j}`;
      const marcada = feitas.has(id);
      return `<li class="item" data-g="${t.g}">
        <label><input type="checkbox" id="${id}" ${marcada ? "checked" : ""}>
          <span class="txt"><span class="grupo">${GRUPOS[t.g]}</span>
          <span class="acao">${t.t}</span></span></label></li>`;
    }).join("");
    return `<section class="encontro${apagado ? " apagado" : ""}${e.evento ? " evento" : ""}">
      <div class="data">
        <span class="ter">${e.ter}</span>
        <span class="qui">${e.evento ? e.qui : e.qui + " qui"}</span>
        ${rotulo ? `<span class="n">${rotulo}</span>` : ""}
      </div>
      <div>
        <p class="pauta${e.semaula ? " semaula" : ""}">${e.pauta}</p>
        ${itens ? `<ul class="lista${visiveis.length > 3 ? " duas" : ""}">${itens}</ul>`
                : (e.tarefas.length && apagado
                    ? `<p class="vazio">Nada do seu grupo vence nesta data.</p>`
                    : (e.tarefas.length ? "" : `<p class="vazio">Nenhuma entrega vence nesta data.</p>`))}
      </div>
    </section>`;
  }).join("");

  alvo.querySelectorAll('input[type="checkbox"]').forEach(c => {
    c.addEventListener("change", () => {
      c.checked ? feitas.add(c.id) : feitas.delete(c.id);
      salvar(); atualizarProgresso();
    });
  });
}

function atualizarProgresso(){
  let total = 0, prontas = 0;
  ENCONTROS.forEach((e, i) => e.tarefas.forEach((t, k) => {
    if (filtro !== "todos" && t.g !== filtro) return;
    total++;
    if ([...feitas].some(id => id.startsWith(`t-${i}-${k}-`))) prontas++;
  }));
  const pct = total ? Math.round(prontas / total * 100) : 0;
  document.getElementById("barra-fill").style.width = pct + "%";
  document.getElementById("barra").setAttribute("aria-valuenow", pct);
  document.getElementById("contador").textContent =
    `${prontas} de ${total} ${total === 1 ? "concluída" : "concluídas"}`;
}

document.getElementById("reset").addEventListener("click", () => {
  feitas.clear(); salvar(); montarTimeline(); atualizarProgresso();
});

montarTags();
montarTimeline();
atualizarProgresso();
</script>
</body>
</html>
